# ==============================================================================
# CFO BUDDY — ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM & Reasoning (Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# Neon Serverless PostgreSQL (Relational + Vector DB)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# MongoDB (Authentication & Thread History)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=cfobuddy

# External Financial APIs
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# JWT Authentication
CFO_BUDDY_JWT_SECRET=generate_a_64_character_hex_string_using_openssl
CFO_BUDDY_AUTH_USERNAME=admin
CFO_BUDDY_AUTH_PASSWORD=choose_a_strong_admin_password
CFO_BUDDY_JWT_EXPIRES_IN_SECONDS=43200

# File Upload Limits
CFO_BUDDY_MAX_UPLOAD_BYTES=20971520

# Frontend API URL (Used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
